# penn-course-mcp configuration. All variables are optional.
# Copy to .env (loaded automatically) or set in your MCP client config.

# Base URL of the Penn Courses API.
PENN_COURSES_BASE_URL=https://penncoursereview.com

# Default semester. Use "current" to auto-resolve via /api/options/, or a code like "2026C".
PENN_COURSES_SEMESTER=current

# Cache time-to-live in seconds for upstream responses.
PENN_COURSES_CACHE_TTL=3600

# HTTP request timeout in seconds.
PENN_COURSES_TIMEOUT=20.0

# User-Agent sent with every request (politeness toward the public service).
# Defaults to "penn-course-mcp/<version>" if unset.
# PENN_COURSES_USER_AGENT=penn-course-mcp/0.1.0

# OPTIONAL: enables detailed Penn Course Review breakdowns (get_course_reviews).
# Paste your full browser session cookie value while logged in to penncoursereview.com,
# e.g. "sessionid=abcdef123..." (you can include multiple cookies separated by "; ").
# When unset, review tools gracefully fall back to the public aggregate ratings.
# PENN_COURSES_SESSION_COOKIE=

# Transport configuration (can also be passed as CLI flags).
# PENN_COURSES_TRANSPORT=stdio   # or "http"
# PENN_COURSES_HOST=127.0.0.1
# PENN_COURSES_PORT=8000
